{
  "version": 2,
  "functions": {"api/index.py": {"maxDuration": 300}},
  "rewrites": [
    {
      "source": "/api/:action",
      "destination": "/api/index?action=:action"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'"
        }
      ]
    }
  ]
}
